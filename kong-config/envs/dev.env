# Non-secret values for kong-config/boutique.yaml in the dev environment.
# deck.sh exports them; decK fills ${{ env "DECK_..." }} with them.
# Values from:  terraform -chdir=terraform-infra/envs/dev output

# output redis_host
DECK_REDIS_HOST="master.boutique-dev-rl.8160nz.use1.cache.amazonaws.com"

# output redis_secret_name (Kong reads the password from this Secrets Manager secret)
DECK_REDIS_SECRET="boutique-dev-kong-redis"

# terraform output oidc_issuer (Cognito user pool for partner OAuth2 login)
DECK_OIDC_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XBQlbQ11X"

# terraform output partner_acme_client_id (Kong consumer partner-acme custom_id)
DECK_PARTNER_ACME_CLIENT_ID="26t70kdrch22bkk5aaadnhosm5"

# Salt for the OIDC token cache keys (not a password; fixed per environment)
DECK_OIDC_CACHE_SALT="9679e5a29e37372d72e9424e2effd62e"
