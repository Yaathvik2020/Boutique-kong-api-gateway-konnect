# Non-secret values for kong-config/boutique.yaml in the prod environment.
# deck.sh exports them; decK fills ${{ env "DECK_..." }} with them.
# Values from:  terraform -chdir=terraform-infra/envs/prod output

# output redis_host
DECK_REDIS_HOST="<redis-primary-endpoint-for-prod>"

# output redis_secret_name (Kong reads the password from this Secrets Manager secret)
DECK_REDIS_SECRET="boutique-prod-kong-redis"
