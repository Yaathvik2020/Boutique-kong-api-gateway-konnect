# Non-secret values for kong-config/boutique.yaml in the prod environment.
# deck.sh exports them; decK fills ${{ env "DECK_..." }} with them.
# Values from:  terraform -chdir=terraform-infra/envs/prod output

# output redis_host
DECK_REDIS_HOST="<redis-primary-endpoint-for-prod>"

# output redis_secret_name (Kong reads the password from this Secrets Manager secret)
DECK_REDIS_SECRET="boutique-prod-kong-redis"

# terraform output oidc_issuer (Cognito user pool for partner OAuth2 login)
DECK_OIDC_ISSUER="<oidc-issuer-for-prod>"

# terraform output partner_acme_client_id (Kong consumer partner-acme custom_id)
DECK_PARTNER_ACME_CLIENT_ID="<partner-acme-client-id-for-prod>"

# Salt for the OIDC token cache keys (not a password; fixed per environment)
DECK_OIDC_CACHE_SALT="edac0169fa85591336eacf9f901a8c44"
